# Fichier d'exemple des variables d'environnement requises (sans secrets réels)
# Copiez ce fichier vers .env ou définissez ces variables dans votre session/IDE

DB_URL=jdbc:postgresql://localhost:5432/tp_rest
DB_USERNAME=tp_api
DB_PASSWORD=<mot_de_passe_local_a_definir>
JWT_SECRET_BASE64=<cle_base64_generee_localement_256_bits_minimum>
JWT_TTL_SECONDS=900
SPRING_PROFILES_ACTIVE=tp
